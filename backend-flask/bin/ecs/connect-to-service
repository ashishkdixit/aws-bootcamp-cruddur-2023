#!/usr/bin/bash

set -e # stop if it fails at any point 

if [ -z "$1" ]; then
  echo "NO TASK_ID argument supplied"
  echo "eg. ./backend-flask/bin/ecs/connect-to-service 86fdd0bcb2874197bc84bcaf027e5f82 backend-flask"
  exit 1
fi
TASK_ID=$1

if [ -z "$2" ]; then
  echo "NO TASK_ID argument supplied"
  echo "eg. ./backend-flask/bin/ecs/connect-to-service 86fdd0bcb2874197bc84bcaf027e5f82 backend-flask"
  exit 1
fi
CONTAINER_NAME=$2


aws ecs execute-command  \
--region $AWS_DEFAULT_REGION \
--cluster cruddur \
--task $TASK_ID \
--container $CONTAINER_NAME \
--command "/bin/bash" \
--interactive