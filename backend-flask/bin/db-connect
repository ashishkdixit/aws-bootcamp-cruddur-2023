#! /usr/bin/bash
CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="db-connect"
printf "${CYAN}==${LABEL}${NO_COLOR}\n"

echo "arg: $1"
if [ "$1" = "prod" ]; then
  echo "Running in production mode"
  URL=$PROD_CONNECTION_URL
  echo "URL: $URL"
else
  echo "Running in development mode"
  URL=$CONNECTION_URL
  echo "URL: $URL"

fi

psql $URL